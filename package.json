{
  "name": "rgd-suite",
  "displayName": "RGD Suite",
  "description": "Corsix, but for VS Code! Complete toolkit for Relic Game Data (RGD) files — table editor, Lua↔RGD conversion, SGA extraction, parity checker, and CLI commands for Dawn of War / Company of Heroes modding.",
  "version": "1.8.0",
  "publisher": "CannibalToast",
  "repository": {
    "type": "git",
    "url": "https://github.com/CannibalToast/rgd-suite"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "activationEvents": [
    "onFileSystem:rgd",
    "workspaceContains:**/*.rgd"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "rgdEditor.rgdEditor",
        "displayName": "RGD Table Editor",
        "selector": [
          {
            "filenamePattern": "*.rgd"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "rgd-text",
        "aliases": [
          "RGD Text",
          "rgd-text"
        ],
        "extensions": [
          ".rgd.txt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rgd-text",
        "scopeName": "source.rgd",
        "path": "./syntaxes/rgd.tmLanguage.json"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "rgdTree",
          "name": "RGD Tree",
          "when": "resourceExtname == .rgd || resourceExtname == .txt && resourceFilename =~ /\\.rgd\\.txt$/",
          "icon": "$(database)"
        }
      ]
    },
    "commands": [
      {
        "command": "rgdEditor.openRgd",
        "title": "Open (Table Editor)",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.openRgdText",
        "title": "Open (Plain Text Editor)",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.convertToText",
        "title": "Convert to Text Format",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.convertToBinary",
        "title": "Convert Text to Binary",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.showInfo",
        "title": "Show File Info",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.extractFromSga",
        "title": "Extract from SGA Archive",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.dumpToLua",
        "title": "Dump to Lua",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.compileToRgd",
        "title": "Compile Lua to RGD",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.editValue",
        "title": "Edit Value",
        "category": "RGD Suite",
        "icon": "$(edit)"
      },
      {
        "command": "rgdEditor.batchToLua",
        "title": "Batch Convert Folder to Lua",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.batchToRgd",
        "title": "Batch Compile Folder to RGD",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.selectLocaleFolder",
        "title": "Select Locale Folder",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.refreshTree",
        "title": "Refresh Tree View",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.revealNode",
        "title": "Reveal Node",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.loadTreeView",
        "title": "Load Tree View",
        "category": "RGD Suite"
      },
      {
        "command": "rgd.fromLua",
        "title": "Convert Lua to RGD (CLI)",
        "category": "RGD Suite"
      },
      {
        "command": "rgd.toLua",
        "title": "Convert RGD to Lua (CLI)",
        "category": "RGD Suite"
      },
      {
        "command": "rgd.info",
        "title": "Show RGD Info (CLI)",
        "category": "RGD Suite"
      },
      {
        "command": "rgd.validate",
        "title": "Validate File (CLI)",
        "category": "RGD Suite"
      },
      {
        "command": "rgd.validatePath",
        "title": "Validate Path",
        "category": "RGD Suite"
      },
      {
        "command": "rgd.validateEncoding",
        "title": "Validate Encoding",
        "category": "RGD Suite"
      },
      {
        "command": "rgd.validateReferences",
        "title": "Validate References",
        "category": "RGD Suite"
      },
      {
        "command": "rgd.batchValidate",
        "title": "Batch Validate Folder",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.checkParity",
        "title": "Check Parity (RGD ↔ Lua)",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.batchCheckParity",
        "title": "Batch Parity Check (Folder)",
        "category": "RGD Suite"
      },
      {
        "command": "rgdEditor.openPowerShellSetup",
        "title": "Open PowerShell Terminal with CLI",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.showGitTableDiff",
        "title": "Show Git Table Diff",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.cloneFile",
        "title": "Clone / Copy As…",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.openCounterpart",
        "title": "Open Counterpart (RGD ↔ Lua ↔ Text)",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.openPairSideBySide",
        "title": "Open RGD + Lua Side by Side",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.openParentReference",
        "title": "Open Parent Reference()",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.findReferencesToFile",
        "title": "Find Files That Reference This",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.searchKeyInFolder",
        "title": "Search Key in Folder…",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.copyAttribPath",
        "title": "Copy Attrib-Relative Path",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.copyDataAttribPath",
        "title": "Copy data/attrib/… Path",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.copyAbsolutePath",
        "title": "Copy Absolute Path",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.copyFileName",
        "title": "Copy File Name",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.copyFileStem",
        "title": "Copy File Stem (no extension)",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.copyHash",
        "title": "Copy RGD Hash…",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.copyReferenceSnippet",
        "title": "Copy Reference() / Inherit Snippet",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.copyFileInfo",
        "title": "Copy File Info as JSON",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.revealAttribRoot",
        "title": "Reveal Attrib Root in Explorer",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.convertSelectionToLua",
        "title": "Convert Selection → Lua",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.convertSelectionToRgd",
        "title": "Convert Selection → RGD",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.convertSelectionToText",
        "title": "Convert Selection → Text",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.stripBom",
        "title": "Strip UTF-8 BOM",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.renamePair",
        "title": "Rename Pair + Update References…",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.compareTwoRgd",
        "title": "Compare Two RGD Tables…",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.newRgdFromTemplate",
        "title": "New Minimal RGD…",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.quickDigest",
        "title": "Quick Digest (Info Dump)",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.compileAndOpen",
        "title": "Compile Lua → RGD and Open",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.refreshCaches",
        "title": "Refresh RGD Caches",
        "category": "RGD Suite"
      },
      {
        "command": "rgdSuite.findFilesByName",
        "title": "Find Files by Name Pattern…",
        "category": "RGD Suite"
      }
    ],
    "submenus": [
      {
        "id": "rgdSuite.explorerContext",
        "label": "RGD Suite",
        "icon": "$(database)"
      },
      {
        "id": "rgdSuite.explorerCopy",
        "label": "Copy…",
        "icon": "$(copy)"
      },
      {
        "id": "rgdSuite.explorerNavigate",
        "label": "Navigate…",
        "icon": "$(go-to-file)"
      },
      {
        "id": "rgdSuite.explorerTools",
        "label": "Tools…",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "rgdSuite.explorerContext",
          "group": "2_workspace@99",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceExtname == .sga || resourceFilename =~ /\\.rgd\\.txt$/ || explorerResourceIsFolder"
        }
      ],
      "rgdSuite.explorerContext": [
        {
          "when": "resourceExtname == .rgd",
          "command": "rgdEditor.openRgd",
          "group": "1_open@1"
        },
        {
          "when": "resourceExtname == .rgd",
          "command": "rgdEditor.openRgdText",
          "group": "1_open@2"
        },
        {
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/",
          "command": "rgdSuite.openCounterpart",
          "group": "1_open@3"
        },
        {
          "when": "resourceExtname == .rgd || resourceExtname == .lua",
          "command": "rgdSuite.openPairSideBySide",
          "group": "1_open@4"
        },
        {
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/",
          "command": "rgdSuite.cloneFile",
          "group": "1_open@5"
        },
        {
          "submenu": "rgdSuite.explorerNavigate",
          "group": "2_nav@1",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/ || explorerResourceIsFolder"
        },
        {
          "submenu": "rgdSuite.explorerCopy",
          "group": "2_nav@2",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/ || explorerResourceIsFolder"
        },
        {
          "submenu": "rgdSuite.explorerTools",
          "group": "2_nav@3",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/ || explorerResourceIsFolder || resourceExtname == .sga"
        },
        {
          "when": "resourceExtname == .rgd",
          "command": "rgdSuite.showGitTableDiff",
          "group": "3_validate@0"
        },
        {
          "when": "resourceExtname == .rgd || resourceExtname == .lua",
          "command": "rgdSuite.checkParity",
          "group": "3_validate@1"
        },
        {
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/",
          "command": "rgd.validatePath",
          "group": "3_validate@2"
        },
        {
          "when": "resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/",
          "command": "rgd.validateEncoding",
          "group": "3_validate@3"
        },
        {
          "when": "resourceExtname == .rgd || resourceExtname == .lua",
          "command": "rgd.validateReferences",
          "group": "3_validate@4"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "rgd.batchValidate",
          "group": "3_validate@5"
        },
        {
          "when": "resourceExtname == .rgd",
          "command": "rgdEditor.convertToText",
          "group": "4_convert@1"
        },
        {
          "when": "resourceFilename =~ /\\.rgd\\.txt$/",
          "command": "rgdEditor.convertToBinary",
          "group": "4_convert@2"
        },
        {
          "when": "resourceExtname == .rgd",
          "command": "rgdEditor.dumpToLua",
          "group": "4_convert@3"
        },
        {
          "when": "resourceExtname == .lua",
          "command": "rgdEditor.compileToRgd",
          "group": "4_convert@4"
        },
        {
          "when": "resourceExtname == .lua",
          "command": "rgdSuite.compileAndOpen",
          "group": "4_convert@6"
        },
        {
          "when": "resourceExtname == .rgd",
          "command": "rgdSuite.convertSelectionToLua",
          "group": "4_convert@7"
        },
        {
          "when": "resourceExtname == .lua",
          "command": "rgdSuite.convertSelectionToRgd",
          "group": "4_convert@8"
        },
        {
          "when": "resourceExtname == .rgd",
          "command": "rgdSuite.convertSelectionToText",
          "group": "4_convert@9"
        },
        {
          "when": "resourceExtname == .lua",
          "command": "rgd.fromLua",
          "group": "5_cli@1"
        },
        {
          "when": "resourceExtname == .rgd",
          "command": "rgd.toLua",
          "group": "5_cli@2"
        },
        {
          "when": "resourceExtname == .rgd",
          "command": "rgd.info",
          "group": "5_cli@3"
        },
        {
          "when": "resourceExtname == .rgd",
          "command": "rgd.validate",
          "group": "5_cli@4"
        },
        {
          "when": "resourceExtname == .rgd",
          "command": "rgdEditor.showInfo",
          "group": "6_info@1"
        },
        {
          "when": "resourceExtname == .rgd",
          "command": "rgdSuite.quickDigest",
          "group": "6_info@2"
        },
        {
          "when": "resourceExtname == .sga",
          "command": "rgdEditor.extractFromSga",
          "group": "6_info@3"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "rgdEditor.batchToLua",
          "group": "7_batch@1"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "rgdEditor.batchToRgd",
          "group": "7_batch@2"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "rgdSuite.batchCheckParity",
          "group": "7_batch@3"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "rgdSuite.searchKeyInFolder",
          "group": "7_batch@4"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "rgdSuite.findFilesByName",
          "group": "7_batch@5"
        },
        {
          "when": "explorerResourceIsFolder",
          "command": "rgdSuite.newRgdFromTemplate",
          "group": "7_batch@6"
        },
        {
          "when": "resourceExtname == .rgd || resourceExtname == .lua || explorerResourceIsFolder",
          "command": "rgdEditor.selectLocaleFolder",
          "group": "8_config@1"
        },
        {
          "when": "resourceExtname == .rgd || resourceExtname == .lua || explorerResourceIsFolder",
          "command": "rgdSuite.refreshCaches",
          "group": "8_config@2"
        }
      ],
      "rgdSuite.explorerNavigate": [
        {
          "command": "rgdSuite.openParentReference",
          "when": "resourceExtname == .rgd || resourceExtname == .lua",
          "group": "1@1"
        },
        {
          "command": "rgdSuite.findReferencesToFile",
          "when": "resourceExtname == .rgd || resourceExtname == .lua",
          "group": "1@2"
        },
        {
          "command": "rgdSuite.revealAttribRoot",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/ || explorerResourceIsFolder",
          "group": "1@3"
        },
        {
          "command": "rgdSuite.searchKeyInFolder",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || explorerResourceIsFolder",
          "group": "1@4"
        },
        {
          "command": "rgdSuite.findFilesByName",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || explorerResourceIsFolder",
          "group": "1@5"
        }
      ],
      "rgdSuite.explorerCopy": [
        {
          "command": "rgdSuite.copyAttribPath",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/",
          "group": "1@1"
        },
        {
          "command": "rgdSuite.copyDataAttribPath",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/",
          "group": "1@2"
        },
        {
          "command": "rgdSuite.copyReferenceSnippet",
          "when": "resourceExtname == .rgd || resourceExtname == .lua",
          "group": "1@3"
        },
        {
          "command": "rgdSuite.copyFileStem",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/",
          "group": "1@4"
        },
        {
          "command": "rgdSuite.copyFileName",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/",
          "group": "1@5"
        },
        {
          "command": "rgdSuite.copyAbsolutePath",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/ || explorerResourceIsFolder",
          "group": "1@6"
        },
        {
          "command": "rgdSuite.copyHash",
          "when": "resourceExtname == .rgd || resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/",
          "group": "1@7"
        },
        {
          "command": "rgdSuite.copyFileInfo",
          "when": "resourceExtname == .rgd",
          "group": "1@8"
        }
      ],
      "rgdSuite.explorerTools": [
        {
          "command": "rgdSuite.renamePair",
          "when": "resourceExtname == .rgd || resourceExtname == .lua",
          "group": "1@1"
        },
        {
          "command": "rgdSuite.compareTwoRgd",
          "when": "resourceExtname == .rgd",
          "group": "1@2"
        },
        {
          "command": "rgdSuite.stripBom",
          "when": "resourceExtname == .lua || resourceFilename =~ /\\.rgd\\.txt$/",
          "group": "1@3"
        }
      ],
      "view/item/context": [
        {
          "when": "view == rgdTree && viewItem == rgdValue",
          "command": "rgdEditor.editValue",
          "group": "inline"
        },
        {
          "when": "view == rgdTree",
          "command": "rgdEditor.revealNode",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "RGD Suite",
      "properties": {
        "rgdEditor.dictionaryPaths": {
          "type": "array",
          "default": [],
          "description": "Paths to additional hash dictionary files (.dic or .txt)"
        },
        "rgdEditor.autoConvertOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically convert text format back to binary on save"
        },
        "rgdEditor.defaultRgdVersion": {
          "type": "number",
          "default": 1,
          "enum": [
            1,
            3
          ],
          "description": "Default RGD version when creating new files"
        },
        "rgdEditor.resolveLocaleStrings": {
          "type": "boolean",
          "default": true,
          "description": "Resolve $-prefixed locale IDs to UCS text when opening RGD files (defers heavy locale scanning when disabled)."
        },
        "rgdEditor.retainWebviewContext": {
          "type": "boolean",
          "default": true,
          "description": "Keep the table editor webview alive when hidden. Disable to reduce memory use on large files."
        },
        "rgdEditor.preferredLanguage": {
          "type": "string",
          "default": "Chinese",
          "enum": [
            "English",
            "Chinese",
            "SChinese",
            "Japanese",
            "German",
            "French",
            "Spanish",
            "Italian",
            "Russian",
            "Korean",
            "Polish"
          ],
          "description": "Preferred language for UCS string resolution"
        },
        "rgdSuite.attribPath": {
          "type": "string",
          "default": "",
          "description": "Path to attrib folder for resolving references (auto-detected if empty)"
        },
        "rgdSuite.vfsCacheSize": {
          "type": "integer",
          "default": 50,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum parsed RGD files cached for the rgd:// virtual text view."
        },
        "rgdSuite.treeCacheSize": {
          "type": "integer",
          "default": 30,
          "minimum": 1,
          "maximum": 500,
          "description": "Maximum parsed RGD files cached for the RGD Tree sidebar (shared parse cache with VFS/editor)."
        },
        "rgdSuite.parityWorkers": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Worker threads for Batch Parity Check. 0 = auto: min(logical CPUs − 1, 4), at least 1."
        },
        "rgdSuite.batchWorkers": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "description": "Worker threads for batch convert and batch validate. 0 = auto: min(logical CPUs − 1, 4), at least 1."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/roundtrip.js && node test/validators.test.js && node test/task-scheduling.test.js && node test/batch-validate-ui.test.js && node test/batch-validate-worker.test.js && node test/package-menu.test.js && node test/cli-parity.test.js && node test/sga-extract-safe.test.js && node test/table-diff.test.js && node test/rename-rewrite.test.js",
    "build": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\" && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node16 --minify --legal-comments=none --resolve-extensions=.ts,.js --tsconfig=tsconfig.json",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node16 --sourcemap --resolve-extensions=.ts,.js --tsconfig=tsconfig.json --watch",
    "package": "vsce package --no-dependencies && node -e \"const {execSync,version}=require('child_process'),p=require('./package.json');const src='rgd-suite-'+p.version+'.vsix';require('fs').copyFileSync(src,'rgd-suite-latest.vsix');console.log('Copied '+src+' -> rgd-suite-latest.vsix')\"",
    "build-all": "npm run build && npm run package",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "lru-cache": "^10.4.3"
  }
}